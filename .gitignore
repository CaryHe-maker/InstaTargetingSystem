# Build directories
build/
build-*/
out/
bin/
lib/
cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
compile_commands.json
_deps/
*.cmake.tmp
CMakeUserPresets.json
CMakeLists.txt.user

# Native build outputs
*.o
*.obj
*.lo
*.la
*.a
*.lib
*.so
*.so.*
*.dll
*.dylib
*.exe
*.out
*.app
*.pdb
*.ilk
*.exp

# IDE and editor state
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.code-workspace

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Runtime logs and temporary files
logs/
*.log
*.tmp
*.temp
*.cache
*.pid
artifacts/
*.db
*.sqlite
*.sqlite3

# Python helper caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Datasets, videos, and generated experiment outputs
data/
datasets/
videos/
results/
outputs/
runs/
experiments/*

# Python source package named ``data`` is code, not a dataset artifact.
!src/instatarget/data/
!src/instatarget/data/*.py
!experiments/.gitkeep
!experiments/README.md

# Model weights and inference engines
models/
weights/
checkpoints/
*.pt
*.pth
*.onnx
*.engine
*.plan
*.trt

# The bundled HiT implementation is source code, not a model artifact.
!src/instatarget/vendor/hit/
!src/instatarget/vendor/hit/lib/
!src/instatarget/vendor/hit/lib/**
src/instatarget/vendor/hit/lib/**/__pycache__/
src/instatarget/vendor/hit/lib/**/*.pyc

# Vendored reference implementations
third_party/

# Docker and package artifacts
*.tar
*.tar.gz
*.zip
*.7z
docker/*.tar

# Keep source, build scripts, docs, and configuration templates tracked.
!CMakeLists.txt
!cmake/
!src/
!include/
!apps/
!tests/
!tools/
!docs/
!docker/
!*.example
!*.template
